# Chiave API di Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

AGENT_NAME=Fiuto
OWNER_NAME=Riccardo
TIMEZONE=Europe/Rome

# Twilio WhatsApp (sandbox: https://console.twilio.com > Messaging > Try it out > WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Il TUO numero: l'agente risponde solo a questo
OWNER_WHATSAPP=whatsapp:+39XXXXXXXXXX
# URL pubblico del webhook, es. https://tuo-dominio/whatsapp
PUBLIC_WEBHOOK_URL=

# Telegram: crea un bot con @BotFather e incolla qui il token
TELEGRAM_BOT_TOKEN=
# Il tuo id: avvia il server, scrivi /start al bot e lui te lo dice
TELEGRAM_OWNER_CHAT_ID=
# Facoltativi: senza webhook il bot usa il polling (non serve un URL pubblico)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Dove arrivano i messaggi proattivi se non hai ancora scritto: whatsapp | telegram
CANALE_PREDEFINITO=whatsapp

# Messaggi vocali
TRASCRIZIONE_LINGUA=it
# Whisper sul tuo server (gratis, privato): tiny | base | small | medium
WHISPER_MODELLO=small
# Oppure un servizio esterno compatibile OpenAI (lascia vuoto per usare Whisper locale), es. Groq:
# TRASCRIZIONE_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRASCRIZIONE_API_MODELLO=whisper-large-v3-turbo
TRASCRIZIONE_API_URL=
TRASCRIZIONE_API_KEY=
TRASCRIZIONE_API_MODELLO=whisper-1
DURATA_MASSIMA_VOCALE=600

# Proattività
PROACTIVE_EVERY_MINUTES=120
PROACTIVE_START_HOUR=8
PROACTIVE_END_HOUR=21
PROACTIVE_MAX_PER_DAY=4
MORNING_BRIEF_HOUR=7
MORNING_BRIEF_MINUTE=45
